# --- segredos -------------------------------------------------------------
# Nada aqui e paranoia: o cliente guarda credencial de servidor, chave SSH e
# token OAuth. Um unico arquivo destes commitado por engano entrega acesso a
# um servidor de producao, e o historico do git nao esquece.
client_secret*.json
credentials*.json
*token*.json
*.pem
*.key
*.ppk
*.pfx
*.p12
.env
.env.*
!.env.example

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- editores / SO --------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
